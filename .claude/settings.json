{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm preview:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "PowerShell(pnpm install:*)",
      "PowerShell(pnpm build:*)",
      "PowerShell(pnpm dev:*)",
      "PowerShell(pnpm audit:*)",
      "PowerShell(pnpm exec tsc:*)",
      "PowerShell(pnpm test:*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(curl:*)",
      "WebFetch(domain:*.supabase.co)"
    ]
  }
}
